PORT=3001
# Required — app will not start without this
JWT_SECRET=replace-me-with-a-long-random-string

# Preferred for live meal vision + summaries (free tier available)
GEMINI_API_KEY=
# Optional model override (default: gemini-3.7-flash)
# GEMINI_MODEL=gemini-3.7-flash
# Comma-separated fallbacks used only after a temporary Gemini capacity error.
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash
# Maximum wait per model request in milliseconds (default: 7000).
# GEMINI_REQUEST_TIMEOUT_MS=7000

# Optional fallback if Gemini is unset
OPENAI_API_KEY=

# Leave both AI keys empty to use deterministic mock AI for demos
